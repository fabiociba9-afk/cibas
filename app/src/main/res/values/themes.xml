<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ExecutivoGo" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:colorPrimary">@color/navy_primary</item>
        <item name="android:colorAccent">@color/emerald_accent</item>
        <item name="android:datePickerDialogTheme">@style/ExecutiveDatePickerTheme</item>
        <item name="android:timePickerDialogTheme">@style/ExecutiveTimePickerTheme</item>
    </style>

    <style name="Theme.MyApplication" parent="Theme.ExecutivoGo" />

    <style name="ExecutiveDatePickerTheme" parent="android:Theme.DeviceDefault.Light.Dialog">
        <item name="android:colorAccent">@color/emerald_accent</item>
        <item name="android:colorPrimary">@color/navy_primary</item>
        <item name="android:windowBackground">@color/slate_light</item>
    </style>

    <style name="ExecutiveTimePickerTheme" parent="android:Theme.DeviceDefault.Light.Dialog">
        <item name="android:colorAccent">@color/emerald_accent</item>
        <item name="android:colorPrimary">@color/navy_primary</item>
        <item name="android:windowBackground">@color/slate_light</item>
    </style>
</resources>
